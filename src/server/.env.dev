# ===== 本地开发环境配置 =====
# 运行环境
NODE_ENV=development
PORT=4000

# 数据库（docker-compose 映射到 3307 端口，避免和本机 MySQL 冲突）
DATABASE_URL="mysql://root:hdochub_dev_2026@localhost:3307/hdochub_blog"

# Redis（docker-compose 映射到 6380 端口，避免和本机 Redis 冲突）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=dev-secret-hdochub-2026
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# 文件上传
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880

# 站点
SITE_URL=http://localhost:4000

# CORS
CORS_ORIGIN=http://localhost:3000
